# Everything is optional. With no variables set, Tidewater runs fully offline in simulator mode.

PORT=8787
TIDEWATER_DB=server/data/tidewater.db

# --- PayPal SANDBOX (set both to switch from the simulator to the sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only sandbox hosts are accepted (localhost allowed for tests).
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_INVOICER_NAME=Tidewater Demo Merchant
PAYPAL_INVOICER_EMAIL=
# Webhook id from the developer dashboard; enables /api/paypal/webhook signature verification.
PAYPAL_WEBHOOK_ID=
PAYPAL_POLL_SECONDS=45

# --- LLM for the Collector agent (any OpenAI-compatible /chat/completions endpoint) ---
# Without these the agent runs on a deterministic offline planner (not a language model).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Public-deployment safeguards (all optional; 0 disables a limit) ---
# Write (POST) requests per IP per minute
RATE_LIMIT_PER_MIN=120
# LLM proxy requests per IP per minute, and in total per UTC day
LLM_PER_MIN=12
LLM_DAILY_CAP=300
# Demo resets per IP per minute (simulator mode)
RESET_PER_MIN=4
# Reverse-proxy hops to trust for the client IP (1 on Render; 0 when running locally without a proxy)
TRUST_PROXY=1
